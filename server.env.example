# Copy to secrets/server.env (0700 dir, 0600 file). Never commit the real file.
# Generate with: openssl rand -hex 32
BATON_SECRET=replace-with-64-hex-characters
BATON_DB=/data/baton.db
BATON_BIND=0.0.0.0:8080
# compose.yaml sets this to the Caddy container's fixed IP: 172.28.0.11/32.
TRUSTED_PROXY_CIDRS=
BATON_LOG=info
